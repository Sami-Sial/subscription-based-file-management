<%- include('partials/header') %>
<h2 style="color: #111827; margin-top: 0;">Reset Your Password</h2>
<p>We received a request to reset the password for your File Cloud account.</p>
<p>Click the button below to choose a new password:</p>
<div style="text-align: center;">
  <a href="<%= resetUrl %>" class="button">Reset Password</a>
</div>
<p style="margin-top: 30px;">If the button doesn't work, copy and paste this link into your browser:</p>
<p style="word-break: break-all; color: #4f46e5; font-size: 14px;"><%= resetUrl %></p>
<p style="margin-top: 20px;">This link will expire in 15 minutes.</p>
<%- include('partials/footer') %>
